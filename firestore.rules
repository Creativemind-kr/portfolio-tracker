rules_version = '2';

// This app has no client-side Firebase SDK usage — every read/write goes through
// server-side Route Handlers using the Firebase Admin SDK (which bypasses these
// rules entirely). Deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
